# Gateway-mode collector: receives OTLP over mTLS, scrubs, batches and routes
# traces -> Tempo, metrics -> Prometheus (OTLP receiver), logs -> Loki (OTLP).
mode: deployment
fullnameOverride: otel-collector
image:
  repository: otel/opentelemetry-collector-contrib
replicaCount: 1

# No ClusterRole: no k8sattributes; workloads set k8s.* resource attributes via the downward API.
serviceAccount:
  automountServiceAccountToken: false

podSecurityContext:
  runAsNonRoot: true
  seccompProfile: {type: RuntimeDefault}
securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities: {drop: [ALL]}

resources: {{ .Values.resources.small | toJson }}

ports:
  otlp: {enabled: true}
  otlp-http: {enabled: false}
  jaeger-compact: {enabled: false}
  jaeger-thrift: {enabled: false}
  jaeger-grpc: {enabled: false}
  zipkin: {enabled: false}
  metrics: {enabled: true}

{{- if .Values.security.mtls }}
extraVolumes:
  - name: otel-tls
    secret:
      secretName: otel-collector-tls
      defaultMode: 0440
extraVolumeMounts:
  - name: otel-tls
    mountPath: /etc/otel-tls
    readOnly: true
{{- end }}

config:
  receivers:
    jaeger: null
    zipkin: null
    prometheus: null
    otlp:
      protocols:
        http: null
        grpc:
          endpoint: ${env:MY_POD_IP}:4317
          {{- if .Values.security.mtls }}
          tls:
            cert_file: /etc/otel-tls/tls.crt
            key_file: /etc/otel-tls/tls.key
            client_ca_file: /etc/otel-tls/ca.crt   # mTLS: unknown clients are rejected
            min_version: "1.3"
          {{- end }}
  processors:
    memory_limiter:
      check_interval: 5s
      limit_percentage: 80
      spike_limit_percentage: 25
    batch:
      send_batch_size: 1024
      timeout: 5s
    resource:
      attributes:
        - {key: deployment.environment.name, value: {{ .Environment.Name }}, action: insert}
    # Defense in depth: never let secrets or (opt-in) prompt content reach the backends.
    attributes/scrub:
      actions:
        - {key: http.request.header.authorization, action: delete}
        - {key: http.request.header.x-admin-key, action: delete}
        {{- if .Values.security.dropPromptContent }}
        - {key: gen_ai.input.messages, action: delete}
        - {key: gen_ai.output.messages, action: delete}
        {{- end }}
  exporters:
    debug: null
    nop: {}   # used when a backend is switched off
    otlp/tempo:
      endpoint: tempo:4317
      tls: {insecure: true}
      sending_queue: {enabled: true, queue_size: 2000}
      retry_on_failure: {enabled: true}
    otlphttp/prometheus:
      endpoint: http://prometheus-server:9090/api/v1/otlp
      tls: {insecure: true}
    otlphttp/loki:
      endpoint: http://loki:3100/otlp
      tls: {insecure: true}
  service:
    telemetry:
      metrics:
        readers:
          - pull:
              exporter:
                prometheus:
                  host: ${env:MY_POD_IP}
                  port: 8888
    pipelines:
      traces:
        receivers: [otlp]
        processors: [memory_limiter, resource, attributes/scrub, batch]
        exporters: [{{ if .Values.components.tempo }}otlp/tempo{{ else }}nop{{ end }}]
      metrics:
        receivers: [otlp]
        processors: [memory_limiter, resource, batch]
        exporters: [{{ if .Values.components.prometheus }}otlphttp/prometheus{{ else }}nop{{ end }}]
      logs:
        receivers: [otlp]
        processors: [memory_limiter, resource, batch]
        exporters: [{{ if .Values.components.loki }}otlphttp/loki{{ else }}nop{{ end }}]
