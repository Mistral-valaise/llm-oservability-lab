# Single-binary Loki on a PVC. Logs arrive via Loki's native OTLP endpoint;
# trace_id/span_id become structured metadata, so Grafana can jump log -> trace.
deploymentMode: SingleBinary

loki:
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  storage:
    type: filesystem
  schemaConfig:
    configs:
      - from: "2025-01-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index: {prefix: loki_index_, period: 24h}
  limits_config:
    allow_structured_metadata: true
    retention_period: {{ .Values.retention.logs }}
    ingestion_rate_mb: 4
  compactor:
    retention_enabled: true
    delete_request_store: filesystem
  analytics:
    reporting_enabled: false
  {{- if .Values.openshift }}
  podSecurityContext:
    runAsUser: null
    runAsGroup: null
    fsGroup: null
    runAsNonRoot: true
  {{- end }}

singleBinary:
  replicas: 1
  resources: {{ .Values.resources.medium | toJson }}
  persistence:
    enabled: true
    size: {{ .Values.storage.loki }}
    {{- with .Values.storage.className }}
    storageClass: {{ . }}
    {{- end }}

read: {replicas: 0}
write: {replicas: 0}
backend: {replicas: 0}

# Namespace-scoped only: no rules sidecar (needs RBAC), no caches, no canary, no gateway.
rbac:
  namespaced: true
sidecar:
  rules:
    enabled: false
gateway: {enabled: false}
chunksCache: {enabled: false}
resultsCache: {enabled: false}
lokiCanary: {enabled: false}
test: {enabled: false}
