      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error_type) (rate(gen_ai_client_operation_duration_seconds_count{job=~\".*ai-gateway\",error_type!=\"\"}[$__rate_interval])) / scalar(sum(rate(gen_ai_client_operation_duration_seconds_count{job=~\".*ai-gateway\"}[$__rate_interval])))",
          "legendFormat": "{{error_type}}",
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Latency p50 / p95 / p99 (click a dot for the trace)",
