        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count{job=~\".*ai-gateway\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}",
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Upstream error ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
